    "list_public_tender_changes": {
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "type": "string",
            "maxLength": 300,
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Pass nextCursor from the previous response to continue where it stopped."
          },
          "since": {
            "type": "string",
            "format": "date-time",
            "description": "Earliest change time with a timezone. Without a cursor or since, the feed starts seven days ago."
          },
          "until": {
            "type": "string",
            "format": "date-time",
            "description": "Exclusive end of the window, with a timezone. With since and until, paging with nextCursor reads one closed window completely."
          },
          "countries": {
            "type": "array",
            "maxItems": 250,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          },
          "sources": {
            "type": "array",
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,100}$"
            },
            "description": "Source IDs from list_public_tender_sources, such as ted-europa."
          },
          "events": {
            "type": "array",
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "published",
                "source_changed",
                "corrected",
                "withdrawn",
                "merged",
                "republished"
              ]
            }
          },
          "sectors": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "construction",
                "medical",
                "it-telecoms",
                "energy",
                "environment",
                "transport",
                "facilities",
                "food",
                "engineering",
                "consulting",
                "education",
                "office",
                "culture",
                "machinery",
                "materials",
                "agriculture"
              ]
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "de",
              "fr"
            ],
            "default": "en"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "items",
          "nextCursor",
          "locale"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "id",
                "revision",
                "changedAt",
                "visibility",
                "changedFields"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                },
                "revision": {
                  "type": "integer"
                },
                "changedAt": {
                  "type": "string"
                },
                "visibility": {
                  "type": "string",
                  "enum": [
                    "public",
                    "withdrawn",
                    "merged"
                  ]
                },
                "replacementId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "titleEn": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "country": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "recordedStatus": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "deadline": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "changedFields": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "event": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "sourcePlatform": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "sector": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "de",
              "fr"
            ],
            "default": "en"
          }
        },
        "additionalProperties": true
      }
    },

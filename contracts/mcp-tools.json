{
  "/mcp": {
    "search_public_tenders": {
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 300
          },
          "countries": {
            "type": "array",
            "maxItems": 250,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          },
          "categories": {
            "type": "array",
            "maxItems": 500,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,100}$"
            }
          },
          "statuses": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "open",
                "closing-soon",
                "closed",
                "awarded",
                "cancelled",
                "suspended",
                "upcoming",
                "unconfirmed"
              ]
            },
            "default": [
              "closing-soon",
              "open",
              "unconfirmed",
              "upcoming"
            ],
            "description": "Omit for active statuses (open, closing-soon, upcoming, unconfirmed). An explicit empty array includes all statuses. closing-soon is an open notice whose deadline is within 7 days (168 hours); a passed deadline shows as closed. OR within each filter, AND between filters and text search."
          },
          "buyer": {
            "type": "string",
            "maxLength": 100
          },
          "sort": {
            "type": "string",
            "enum": [
              "relevance",
              "deadline",
              "newest"
            ],
            "default": "relevance"
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000,
            "default": 1
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "de",
              "fr"
            ],
            "default": "en"
          },
          "view": {
            "type": "string",
            "enum": [
              "compact",
              "full"
            ],
            "default": "compact",
            "description": "compact returns what is needed to choose and cite a notice; full returns whole records (notice text, facts, history), at most 20 per page."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          },
          "sectors": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "construction",
                "medical",
                "it-telecoms",
                "energy",
                "environment",
                "transport",
                "facilities",
                "food",
                "engineering",
                "consulting",
                "education",
                "office",
                "culture",
                "machinery",
                "materials",
                "agriculture"
              ]
            },
            "description": "Broad sectors grouping every category and CPV code, such as construction or it-telecoms. Prefer this to category IDs for broad needs."
          },
          "deadlineFrom": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[0-9:.]+(Z|[+-]\\d{2}:\\d{2}))?$",
            "description": "Earliest submission deadline: an ISO date (from its start, UTC) or a time with a timezone. Date-only deadlines count as the end of their day."
          },
          "deadlineTo": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[0-9:.]+(Z|[+-]\\d{2}:\\d{2}))?$",
            "description": "Latest submission deadline: an ISO date (to its end, UTC) or a time with a timezone. Notices without a deadline are excluded once either bound is set."
          },
          "cpv": {
            "type": "array",
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^\\d{2,8}$"
            },
            "description": "CPV code prefixes, such as 45 (construction work) or 72 (IT services). Matches notices whose source lists such a code."
          },
          "valueMin": {
            "type": "number",
            "minimum": 0,
            "description": "Lowest estimated value; needs currency."
          },
          "valueMax": {
            "type": "number",
            "minimum": 0,
            "description": "Highest estimated value; needs currency."
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "Currency of valueMin and valueMax, such as CHF or EUR. Only notices stating an estimated value in this currency match; amounts are not converted."
          },
          "place": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100,
            "description": "Part of the place of performance or buyer location as published, such as Genève or Zürich. Spelling matters; many notices name only a region."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "limit",
          "filters",
          "locale",
          "url",
          "nextPage"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "required": [
                "id",
                "url",
                "title",
                "summary",
                "status",
                "locale",
                "deadline",
                "modifiedAt"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "title": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "locale": {
                  "type": "string",
                  "enum": [
                    "en",
                    "de",
                    "fr"
                  ],
                  "default": "en"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "open",
                    "closing-soon",
                    "closed",
                    "awarded",
                    "cancelled",
                    "suspended",
                    "upcoming",
                    "unconfirmed"
                  ]
                },
                "country": {
                  "type": "string"
                },
                "deadline": {
                  "type": "object",
                  "required": [
                    "at",
                    "date",
                    "precision"
                  ],
                  "properties": {
                    "at": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "date": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "precision": {
                      "type": "string",
                      "enum": [
                        "instant",
                        "date",
                        "unavailable"
                      ]
                    }
                  },
                  "additionalProperties": true
                },
                "modifiedAt": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "filters": {
            "type": "object",
            "additionalProperties": true
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "de",
              "fr"
            ],
            "default": "en"
          },
          "url": {
            "type": "string"
          },
          "nextPage": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },

          },
          "content": {
            "type": "string"
          }
        }
      }
    }
  },
  "/mcp/product": {
    "get_ziva_pricing_document": {
      "inputSchema": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "enum": [
              "CHF",
              "USD",
              "EUR"
            ],
            "default": "CHF"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "model",
          "currency",
          "canonicalPricing",
          "intelligence",
          "projects"
        ],
        "properties": {
          "model": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "enum": [
              "CHF",
              "USD",
